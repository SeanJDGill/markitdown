---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentTypeBadge from '../../components/ContentTypeBadge.astro';
import TagList from '../../components/TagList.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import { getAllUxBites } from '../../data/content';
import { withBase } from '../../lib/url';

export const getStaticPaths = (async () => {
  const bites = await getAllUxBites();
  return bites.map((bite) => ({ params: { slug: bite.slug }, props: { bite } }));
}) satisfies GetStaticPaths;

const { bite } = Astro.props;
const { Content } = await bite.render();
---

<BaseLayout
  title={bite.title}
  description={bite.insight}
  image={`/og/ux-bites/${bite.slug}.png`}
  type="article"
  publishDate={bite.publishDate}
>
  <article class="container-prose pt-12 sm:pt-16">
    <div class="flex items-center gap-3 text-sm">
      <ContentTypeBadge type="uxBite" />
      {bite.company && <span class="font-medium text-ink-soft">{bite.company}</span>}
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight leading-tight mt-5">{bite.title}</h1>
    <p class="text-xl text-ink-soft mt-4 leading-relaxed">{bite.insight}</p>
    {
      bite.image && (
        <img
          src={withBase(bite.image.src)}
          alt={bite.image.alt}
          class="w-full rounded-2xl border border-line bg-surface aspect-[3/2] object-cover mt-8"
        />
      )
    }
    <div class="prose prose-editorial max-w-none mt-10">
      <Content />
    </div>
    <TagList topics={bite.topics} class="mt-10" />
    <div class="mt-14"><NewsletterSignup /></div>
  </article>
</BaseLayout>
