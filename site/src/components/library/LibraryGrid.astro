---
import type { CaseStudy } from '../../data/types';
import CaseStudyCard from '../CaseStudyCard.astro';
import { topicLabel } from '../../lib/site';

interface Props {
  studies: CaseStudy[];
  topics: string[];
  companies: string[];
}
const { studies, topics, companies } = Astro.props;
---

<div data-library>
  <form class="flex flex-col gap-4 mb-10" role="search" aria-label="Filter case studies">
    <input
      type="search"
      data-filter-query
      placeholder="Search teardowns…"
      class="w-full rounded-lg border border-line bg-surface px-4 py-3 placeholder:text-muted"
      aria-label="Search teardowns"
    />
    <div class="flex flex-wrap gap-3">
      <select data-filter-topic class="rounded-lg border border-line bg-surface px-3 py-2 text-sm">
        <option value="">All topics</option>
        {topics.map((t) => <option value={t}>{topicLabel(t)}</option>)}
      </select>
      <select data-filter-company class="rounded-lg border border-line bg-surface px-3 py-2 text-sm">
        <option value="">All companies</option>
        {companies.map((c) => <option value={c}>{c}</option>)}
      </select>
      <button
        type="button"
        data-filter-clear
        class="text-sm font-medium text-ink-soft hover:text-accent px-2"
      >
        Clear
      </button>
      <span data-result-count class="ml-auto self-center text-sm text-muted"></span>
    </div>
  </form>

  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-grid>
    {studies.map((study) => <CaseStudyCard study={study} />)}
  </div>

  <p data-empty class="hidden text-center text-muted py-16">
    No teardowns match those filters. <button type="button" data-filter-clear class="text-accent font-medium">Reset</button>
  </p>
</div>

<script>
  import { matches, type FilterState } from '../../lib/filtering';

  document.querySelectorAll<HTMLElement>('[data-library]').forEach((root) => {
    const queryEl = root.querySelector<HTMLInputElement>('[data-filter-query]');
    const topicEl = root.querySelector<HTMLSelectElement>('[data-filter-topic]');
    const companyEl = root.querySelector<HTMLSelectElement>('[data-filter-company]');
    const countEl = root.querySelector<HTMLElement>('[data-result-count]');
    const emptyEl = root.querySelector<HTMLElement>('[data-empty]');
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-card]'));

    function apply() {
      const state: FilterState = {
        query: queryEl?.value ?? '',
        topic: topicEl?.value || null,
        company: companyEl?.value || null,
      };
      let visible = 0;
      for (const card of cards) {
        const ok = matches(
          {
            title: card.dataset.title ?? '',
            company: card.dataset.company ?? '',
            topics: (card.dataset.topics ?? '').split(',').filter(Boolean),
          },
          state,
        );
        card.classList.toggle('hidden', !ok);
        if (ok) visible++;
      }
      if (countEl) countEl.textContent = `${visible} teardown${visible === 1 ? '' : 's'}`;
      emptyEl?.classList.toggle('hidden', visible !== 0);
    }

    function clear() {
      if (queryEl) queryEl.value = '';
      if (topicEl) topicEl.value = '';
      if (companyEl) companyEl.value = '';
      apply();
    }

    queryEl?.addEventListener('input', apply);
    topicEl?.addEventListener('change', apply);
    companyEl?.addEventListener('change', apply);
    root.querySelectorAll('[data-filter-clear]').forEach((b) => b.addEventListener('click', clear));
    apply();
  });
</script>
