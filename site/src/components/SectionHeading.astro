---
import { withBase } from '../lib/url';

interface Props {
  title: string;
  eyebrow?: string;
  href?: string;
  hrefLabel?: string;
}
const { title, eyebrow, href, hrefLabel = 'View all' } = Astro.props;
---

<div class="flex items-end justify-between gap-4 mb-8">
  <div>
    {eyebrow && <p class="text-accent font-semibold text-sm uppercase tracking-wide">{eyebrow}</p>}
    <h2 class="text-2xl sm:text-3xl font-bold tracking-tight mt-1">{title}</h2>
  </div>
  {
    href && (
      <a href={withBase(href)} class="text-sm font-medium text-ink-soft hover:text-accent whitespace-nowrap">
        {hrefLabel} →
      </a>
    )
  }
</div>
