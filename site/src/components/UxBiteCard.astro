---
import type { UxBite } from '../data/types';
import ContentTypeBadge from './ContentTypeBadge.astro';

interface Props {
  bite: UxBite;
}
const { bite } = Astro.props;
---

<article class="flex flex-col rounded-xl bg-surface border border-line p-5 hover:border-accent transition-colors h-full">
  <div class="flex items-center gap-3 text-sm">
    <ContentTypeBadge type="uxBite" />
    {bite.company && <span class="font-medium text-ink-soft">{bite.company}</span>}
  </div>
  <h3 class="font-bold tracking-tight text-lg leading-snug mt-3">
    <a href={`/ux-bites/${bite.slug}/`} class="hover:text-accent transition-colors">{bite.title}</a>
  </h3>
  <p class="text-ink-soft text-sm leading-relaxed mt-2">{bite.insight}</p>
</article>
