---
interface Props {
  cite?: string;
}
const { cite } = Astro.props;
---

<figure class="my-12 not-prose text-center">
  <blockquote class="text-2xl sm:text-3xl font-bold tracking-tight leading-snug text-ink">
    <slot />
  </blockquote>
  {cite && <figcaption class="mt-3 text-sm text-muted">— {cite}</figcaption>}
</figure>
