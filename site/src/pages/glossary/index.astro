---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTooltips } from '../../data/content';
import { topicLabel } from '../../lib/site';
import { withBase } from '../../lib/url';

const terms = await getAllTooltips();
---

<BaseLayout title="UX Glossary" description="Plain-English definitions of the UX terms we use.">
  <section class="container-prose pt-12 sm:pt-16 pb-8">
    <p class="text-accent font-semibold uppercase tracking-widest text-sm">Glossary</p>
    <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight mt-3">UX terms, plainly</h1>
    <p class="text-lg text-ink-soft mt-4">The vocabulary behind the teardowns, defined.</p>
  </section>

  <section class="container-prose pb-16">
    <dl class="divide-y divide-line">
      {
        terms.map((t) => (
          <div id={t.slug} class="py-6 scroll-mt-20">
            <dt class="text-xl font-bold flex flex-wrap items-baseline gap-2">
              {t.term}
              {t.aliases.length > 0 && (
                <span class="text-sm font-normal text-muted">({t.aliases.join(', ')})</span>
              )}
            </dt>
            <dd class="text-ink-soft mt-2 leading-relaxed">{t.definition}</dd>
            {t.relatedTopics.length > 0 && (
              <dd class="mt-3 flex flex-wrap gap-2">
                {t.relatedTopics.map((topic) => (
                  <a
                    href={withBase(`/topics/${topic}/`)}
                    class="text-xs font-medium px-2.5 py-1 rounded-full border border-line text-ink-soft hover:border-accent hover:text-accent"
                  >
                    {topicLabel(topic)}
                  </a>
                ))}
              </dd>
            )}
          </div>
        ))
      }
    </dl>
  </section>
</BaseLayout>
