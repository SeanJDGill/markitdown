---
import { topicLabel } from '../lib/site';
import { withBase } from '../lib/url';

interface Props {
  topics: string[];
  class?: string;
}
const { topics, class: cls } = Astro.props;
---

<ul class:list={['flex flex-wrap gap-2', cls]}>
  {
    topics.map((t) => (
      <li>
        <a
          href={withBase(`/topics/${t}/`)}
          class="inline-block text-xs font-medium px-2.5 py-1 rounded-full border border-line text-ink-soft hover:border-accent hover:text-accent transition-colors"
        >
          {topicLabel(t)}
        </a>
      </li>
    ))
  }
</ul>
