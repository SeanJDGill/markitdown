---
import type { CaseStudy } from '../data/types';
import ContentTypeBadge from './ContentTypeBadge.astro';
import { topicLabel } from '../lib/site';
import { withBase } from '../lib/url';

const href = withBase(`/case-studies/${Astro.props.study.slug}/`);

interface Props {
  study: CaseStudy;
  /** Larger treatment for featured/hero placements. */
  feature?: boolean;
}
const { study, feature = false } = Astro.props;
---

<article
  class:list={[
    'group flex flex-col rounded-xl overflow-hidden bg-surface border border-line hover:border-accent transition-colors',
    feature ? 'sm:flex-row' : '',
  ]}
  data-card
  data-title={study.title}
  data-company={study.company}
  data-topics={study.topics.join(',')}
>
  <a href={href} class:list={['block overflow-hidden', feature ? 'sm:w-1/2' : '']}>
    <img
      src={withBase(study.hero.src)}
      width={study.hero.width}
      height={study.hero.height}
      alt={study.hero.alt}
      loading="lazy"
      class="w-full h-full object-cover aspect-[16/9] group-hover:scale-[1.02] transition-transform duration-500"
    />
  </a>
  <div class:list={['p-5 flex flex-col gap-3', feature ? 'sm:w-1/2 sm:p-8 sm:justify-center' : '']}>
    <div class="flex items-center gap-3 text-sm text-muted">
      <ContentTypeBadge type="caseStudy" />
      <span class="font-medium text-ink-soft">{study.company}</span>
      {study.rating != null && <span class="ml-auto font-bold text-accent">{study.rating}/10</span>}
    </div>
    <h3 class:list={['font-bold tracking-tight leading-snug', feature ? 'text-2xl' : 'text-lg']}>
      <a href={href} class="hover:text-accent transition-colors">
        {study.title}
      </a>
    </h3>
    <p class="text-ink-soft text-sm leading-relaxed">{study.excerpt}</p>
    <div class="mt-auto flex flex-wrap gap-2 pt-2 text-xs text-muted">
      {study.topics.slice(0, 3).map((t) => <span>#{topicLabel(t)}</span>)}
      {study.readingTime && <span class="ml-auto">≈ {study.readingTime} min</span>}
    </div>
  </div>
</article>
